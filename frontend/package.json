{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node api.js && next dev --webpack",
    "build": "node api.js && next build",
    "start": "node api.js && next start --webpack",
    "lint": "eslint",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "type-check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ci": "CI=true playwright test",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install --with-deps",
    "bindings:generate": "stellar contract bindings typescript --wasm ../target/wasm32-unknown-unknown/release/soroban_token.wasm --output-dir lib/bindings/token --overwrite && stellar contract bindings typescript --wasm ../target/wasm32-unknown-unknown/release/soroban_vesting.wasm --output-dir lib/bindings/vesting --overwrite",
    "bindings:check": "npm run bindings:generate && git diff --exit-code lib/bindings"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@noble/hashes": "^1.8.0",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^14.5.0",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.575.0",
    "next": "16.2.12",
    "next-intl": "^4.11.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "recharts": "^3.7.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.1",
    "@swc/helpers": "^0.5.23",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "axe-core": "^4.11.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
